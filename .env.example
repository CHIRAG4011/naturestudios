# =====================================================================
# NATURESTUDIOS — ENVIRONMENT VARIABLES (.env.example)
# PRODUCTION DOMAIN: https://naturestudio.in
# =====================================================================
# Copy to `.env` for local development: cp .env.example .env
# In production, set these variables in Vercel Project Settings -> Environment Variables.
# NEVER commit real secret values to version control.
# =====================================================================

# ─── MONGODB ATLAS DATABASE ──────────────────────────────────────────
# Production database connection string (TLS required, connection cached for Vercel serverless)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/naturestudios?retryWrites=true&w=majority
MONGODB_URI=

# Optional local Prisma SQLite fallback if running offline development without MongoDB
DATABASE_URL="file:./prisma/dev.db"

# ─── AUTHENTICATION & SECURITY ───────────────────────────────────────
# 64-character cryptographically secure random string used for session hashing
AUTH_SECRET=

# 256-bit AES-GCM encryption key for application-level encryption at rest
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── CANONICAL APPLICATION URL ───────────────────────────────────────
# Absolute production domain (no trailing slash)
APP_URL=https://naturestudio.in

# ─── RESEND MULTI-MAILBOX CONFIGURATION ──────────────────────────────
# Resend API Key from resend.com
RESEND_API_KEY=

# Verified domain: naturestudio.in
RESEND_FROM_EMAIL=noreply@naturestudio.in
RESEND_INQUIRIES_EMAIL=inquiries@naturestudio.in
RESEND_ADMIN_EMAIL=admin@naturestudio.in
RESEND_SUPPORT_EMAIL=support@naturestudio.in
RESEND_NOREPLY_EMAIL=noreply@naturestudio.in
RESEND_PORTFOLIO_EMAIL=portfolio@naturestudio.in

# ─── GOOGLE OAUTH 2.0 (BRANDED AS NATURESTUDIOS) ──────────────────────
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# In Production: https://naturestudio.in/api/auth/google/callback
# In Local Dev: http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://naturestudio.in/api/auth/google/callback
